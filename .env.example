# ── Cadence environment ─────────────────────────────────────────────
# Copy to server/.env (or export in your shell) and fill in real values.
# Never commit real secrets.

# Server
PORT=4000
DATA_DIR=./data
JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGIN=http://localhost:5173

# AI provider: "local" works with no keys. Set to "openai" (or compatible)
# endpoint to use a hosted model. The app always validates AI output.
AI_PROVIDER=local
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
